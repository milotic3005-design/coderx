{
  "name": "coderx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts --if-database-url && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:discover": "tsx scripts/ingest.ts --discover",
    "refresh:purple-book": "tsx scripts/refresh-purple-book.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "e2e:db": "tsx scripts/seed-e2e.ts",
    "audit": "npm audit --omit=dev",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bwip-js": "^4.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "24.x"
  }

# CodeRx environment variables. Copy to .env.local for local overrides.
# App settings use a CODERX_ prefix so they never collide with variables inherited from tooling.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, RDS, or local Postgres). Required in production.
# Neon via the Vercel Marketplace injects this automatically. Use the pooled connection string.
# When unset (local development only), CodeRx uses embedded PGlite in CODERX_PGLITE_DIR.
DATABASE_URL=

# Local embedded PostgreSQL (PGlite) data directory, or memory:// for a throwaway database.
CODERX_PGLITE_DIR=.data/pglite

# Max pooled connections per server instance (node-postgres).
CODERX_DB_POOL_MAX=5

# --- Security ---------------------------------------------------------------
# Bearer token for POST /api/admin/import (>= 32 random characters). Leave unset to disable the endpoint.
# Generate with: openssl rand -base64 48
CODERX_ADMIN_TOKEN=

# Secret Vercel Cron sends as "Authorization: Bearer $CRON_SECRET" to /api/cron/refresh (>= 16 characters).
CRON_SECRET=

# --- Data refresh -----------------------------------------------------------
# Minimum days between FDA NDC Directory imports (FDA publishes daily). Default 7.
CODERX_FDA_REFRESH_DAYS=7

# Earliest CMS quarter to import (YYYY-Qn). Older postings use unsupported formats. Default 2021-Q1.
CODERX_MIN_PERIOD=2021-Q1

# --- Site -------------------------------------------------------------------
# Public base URL used for canonical links, the sitemap, and Open Graph tags.
# On Vercel this defaults to the production domain (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=

# Set to 1 to bypass the Next.js data cache (debugging only).
CODERX_DISABLE_DATA_CACHE=
